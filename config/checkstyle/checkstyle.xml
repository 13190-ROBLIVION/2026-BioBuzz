<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!-- BioBuzz lint config.
     severity="error"   -> real bug patterns, these FAIL the Java Lint workflow
     severity="warning" -> style/naming hints, shown in the report but never fail CI -->
<module name="Checker">
    <property name="charset" value="UTF-8"/>

    <module name="TreeWalker">
        <!-- ============ BUGS (fail CI) ============ -->
        <!-- catch (Exception e) { } with nothing in it -->
        <module name="EmptyCatchBlock"/>
        <!-- equals() without hashCode() and vice versa -->
        <module name="EqualsHashCode"/>
        <!-- if/else branches in the wrong order (default must come last) -->
        <module name="DefaultComesLast"/>
        <!-- comparing strings with == instead of .equals() -->
        <module name="StringLiteralEquality"/>
        <!-- (x == true) / (x == false) -->
        <module name="SimplifyBooleanExpression"/>
        <!-- if (x) return true; else return false; -->
        <module name="SimplifyBooleanReturn"/>

        <!-- ============ STYLE / NAMING (warnings only) ============ -->
        <!-- imports that are never used (deeper analysis stays with CodeQL) -->
        <module name="UnusedImports">
            <property name="severity" value="warning"/>
        </module>
        <module name="RedundantImport">
            <property name="severity" value="warning"/>
        </module>
        <module name="AvoidStarImport">
            <property name="severity" value="warning"/>
        </module>
        <!-- class names UpperCamelCase (lowercase Teleop files land here) -->
        <module name="TypeName">
            <property name="severity" value="warning"/>
        </module>
        <module name="MethodName">
            <property name="severity" value="warning"/>
        </module>
        <module name="LocalVariableName">
            <property name="severity" value="warning"/>
        </module>
        <module name="ParameterName">
            <property name="severity" value="warning"/>
        </module>
        <module name="MemberName">
            <property name="severity" value="warning"/>
        </module>
        <!-- missing @Override on overrides -->
        <module name="MissingOverride">
            <property name="severity" value="warning"/>
        </module>
        <module name="OneTopLevelClass">
            <property name="severity" value="warning"/>
        </module>
        <module name="OuterTypeFilename">
            <property name="severity" value="warning"/>
        </module>
        <module name="ArrayTypeStyle">
            <property name="severity" value="warning"/>
        </module>
        <module name="UpperEll">
            <property name="severity" value="warning"/>
        </module>
    </module>
</module>
